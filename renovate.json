{
  "extends": ["config:recommended"],
  "timezone": "Europe/Stockholm",
  "automergeSchedule": ["after 8am and before 8pm"],
  "major": {
    "dependencyDashboardApproval": true
  },
  "addLabels": ["renovate"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ]
}
